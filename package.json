{
  "name": "mergist",
  "version": "1.5.0",
  "description": "Generate merge request and pull request descriptions from your git diff.",
  "type": "module",
  "bin": {
    "mergist": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/ui/index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --minify --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && mkdir -p dist/ui && cp src/ui/index.html dist/ui/index.html",
    "dev": "tsx src/index.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "release": "release-it"
  },
  "keywords": [
    "gitlab",
    "github",
    "merge-request",
    "pull-request",
    "mr-description",
    "pr-description",
    "code-review",
    "ai",
    "openai",
    "cli",
    "automation",
    "devops",
    "mergist"
  ],
  "author": "solehudin5699",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solehudin5699/mergist.git"
  },
  "bugs": {
    "url": "https://github.com/solehudin5699/mergist/issues"
  },
  "homepage": "https://github.com/solehudin5699/mergist#readme",
  "devDependencies": {
    "@clack/prompts": "^1.4.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^22.10.7",
    "axios": "^1.7.9",
    "commander": "^11.1.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "release-it": "^20.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
